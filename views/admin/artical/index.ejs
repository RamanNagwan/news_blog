<div id="admin-content">
    <div class="container">
        <div class="row">
            <div class="col-md-10">
                <h1 class="admin-heading"><i class="fa fa-file-text"></i> All Articles</h1>
            </div>
            <div class="col-md-2">
                <a class="add-new" href="/api/admin/add-artical">Add New Article</a>
            </div>
            <div id="articalTable">
            </div>

        </div>
    </div>
</div>

<script>
    const articalData = `<%- JSON.stringify(articales)%>`;
    console.log(articalData);
    document.addEventListener('DOMContentLoaded', () => {
        const table = new Tabulator("#articalTable", {
            data: articalData,
            layout: "fitColumns",
            responsiveLayout: "hide",
            pagination: true,
            paginationMode: "local",
            paginationSize: 10,
            paginationSizeSelector: [25, 50, 100],
            columns: [
                { title: "S.No.", formatter: "rownum", hozAlign: "center", width: 70 },
                { title: 'Title', field: 'title', hozAlign: "center" },
                { title: 'Contnet', field: 'content', hozAlign: "center" },
                { title: 'Cateogry', field: 'category.name', hozAlign: "center" },
                { title: 'Author', field: 'author.fullname', hozAlign: "center" },
                {
                    title: 'Published', field: 'createdAt', formatter: function (cell) {
                        const date = new Date(cell.getValue());
                        return date.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
                    }, hozAlign: "center"
                },
                {
                    title: 'Edit', hozAlign: "center", formatter: function (cell) {
                        return `<a href="/api/admin/update-artical/${cell.getData()._id}"><i class='fa fa-edit'></i></a>`
                    }
                },
                {
                    title: 'Delete', hozAlign: "center", formatter: function (cell) {
                        return `<div onclick="deleteArtical('${cell.getData()._id}')"><i class='fa fa-trash-o'></div>`;
                    }
                }
            ]
        })
    })


    async function deleteArtical(id) {
        if (!confirm("Are you sure you want to delete this article?")) return;
        try {
            const response = await fetch(`/api/admin/delete-article/${id}`,
                { method: "DELETE" }
            )
            const data = await response.json();
            if (response.ok) {
                window.location.reload();
            }
        } catch (err) {
            console.log('Delete error', err);
        }
    }

</script>

<link href="https://unpkg.com/tabulator-tables/dist/css/tabulator.min.css" rel="stylesheet">
<script type="text/javascript" src="https://unpkg.com/tabulator-tables/dist/js/tabulator.min.js"></script>
</head>