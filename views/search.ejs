<div class="col-md-8">
    <!-- post-container -->
    <div class="post-container">
        <h2 class="page-heading">Search : Search Term</h2>
        <% searchNews.forEach((search)=>{ %>
            <div class="post-content">
                <div class="row">
                    <div class="col-md-4">
                        <a class="post-img" href="/single-news/<%=search._id%>"><img src="/uploads/<%=search.image %>"
                                alt="" /></a>
                    </div>
                    <div class="col-md-8">
                        <div class="inner-content clearfix">
                            <h3><a href='/single-news/<%=search._id %>'>Lorem ipsum dolor sit amet, consectetur
                                    adipiscing elit</a></h3>
                            <div class="post-information">
                                <span>
                                    <i class="fa fa-tags" aria-hidden="true"></i>
                                    <a href='category.html'>
                                        <%=search.category.name %>
                                    </a>
                                </span>
                                <span>
                                    <i class="fa fa-user" aria-hidden="true"></i>
                                    <a href='author.html'>
                                        <%=search.author.fullname %>
                                    </a>
                                </span>
                                <span>
                                    <i class="fa fa-calendar" aria-hidden="true"></i>
                                    <%=search.createdAt.toLocaleDateString("en-GB", { day: "numeric" , month: "long" ,
                                        year: "numeric" , }) %>

                                </span>
                            </div>
                            <p class="description">
                                <%= search.content %>
                            </p>
                            <a class='read-more pull-right' href='/single-news/<%=search._id %>'>read more</a>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
                <nav>
                    <ul class="pagination">
                        <li class="page-item disabled">
                            <a class="page-link">Previous</a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">1</a></li>
                        <li class="page-item active">
                            <a class="page-link" href="#" aria-current="page">2</a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    </ul>
                </nav>
    </div><!-- /post-container -->
</div>