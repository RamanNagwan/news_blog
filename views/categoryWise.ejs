<div class="col-md-8">
    <!-- post-container -->
    <div class="post-container">
        <h2 class="page-heading">Category Name : <%=categoryName.name %>
        </h2>
        <% const categoriesNews=paginate.docs; categoriesNews.forEach((categoryNews)=>{ %>
            <div class="post-content">
                <div class="row">
                    <div class="col-md-4">
                        <a class="post-img" href="/single-news/<%= categoryNews._id %>">
                            <img src="/uploads/<%=categoryNews.image %>" alt="" />
                        </a>
                    </div>
                    <div class="col-md-8">
                        <div class="inner-content clearfix">
                            <h3><a href='/single-news/<%= categoryNews._id %>'>
                                    <%=categoryNews.title %>
                                </a></h3>
                            <div class="post-information">
                                <span>
                                    <i class="fa fa-tags" aria-hidden="true"></i>
                                    <a href=' /single-category/<%=categoryNews.category._id %>'>
                                        <%=categoryNews.category.slug %>
                                    </a>
                                </span>
                                <span>
                                    <i class="fa fa-user" aria-hidden="true"></i>
                                    <a href='author.html'>
                                        <%=categoryNews.author.fullname %>
                                    </a>
                                </span>
                                <span>
                                    <i class="fa fa-calendar" aria-hidden="true"></i>
                                    <%=categoryNews.createdAt.toLocaleDateString("en-GB", { day: "numeric" ,
                                        month: "long" , year: "numeric" , }) %>
                                </span>
                            </div>
                            <p class="description">
                                <%=categoryNews.content%>
                            </p>
                            <a class='read-more pull-right' href='/single-news/<%= categoryNews._id %>'>read more</a>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>

                <nav>
                    <ul class="pagination">
                        <li class="page-item <%= paginate.hasPrevPage ? '' : 'disabled' %>">
                            <a class="page-link"
                                href="/category/<%=categoryName._id%>/?page=<%=paginate.prevPage %>">Previous</a>
                        </li>
                        <% for(let i=1; i <=paginate.totalPages; i++){ %>
                            <li class="page-item <%=paginate.page == i ? 'active' : '' %> "><a class="page-link"
                                    href="/category/<%=categoryName._id%>/?page=<%=i%>">
                                    <%=i %>
                                </a></li>
                            <% } %>
                                <li class="page-item">
                                    <a class="page-link <%= paginate.hasNextPage ? '':'disabled' %>"
                                        href="/category/<%=categoryName._id%>/?page=<%=paginate.nextPage %>">Next</a>
                                </li>
                    </ul>
                </nav>
    </div><!-- /post-container -->
</div>