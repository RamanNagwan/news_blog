<div class="col-md-8">
    <!-- post-container -->
    <div class="post-container">
        <h2 class="page-heading">Author Name : <%=authorName.fullname %></h2>
        <% authorNews.forEach((authorArticle)=>{ %>
  <div class="post-content">
            <div class="row">
                <div class="col-md-4">
                    <a class="post-img" href="/single-news/<%= authorArticle._id%>">
                        <img src="/uploads/<%= authorArticle.image%>" alt="" />
                    </a>
                </div>
                <div class="col-md-8">
                    <div class="inner-content clearfix">
                        <h3><a href='/single-news/<%= authorArticle._id%>'><%=authorArticle.title %></a></h3>
                        <div class="post-information">
                            <span>
                                <i class="fa fa-tags" aria-hidden="true"></i>
                                <a href='category.html'><%=authorArticle.category.name %></a>
                            </span>
                            <span>
                                <i class="fa fa-user" aria-hidden="true"></i>
                                <a ><%=authorArticle.author.fullname %></a>
                            </span>
                            <span>
                                <i class="fa fa-calendar" aria-hidden="true"></i>
                                <%=authorArticle.createdAt.toLocaleDateString("en-GB", { day: "numeric" ,
                                        month: "long" , year: "numeric" , }) %>
                            </span>
                        </div>
                        <p class="description"><%=authorArticle.content.substring(0,150) %>...
                        </p>
                        <a class='read-more pull-right' href='/single-news/<%= authorArticle._id%>'>read more</a>
                    </div>
                </div>
            </div>
        </div>
       <% }) %>
        <nav>
            <ul class="pagination">
                <li class="page-item disabled">
                    <a class="page-link">Previous</a>
                </li>
                <li class="page-item"><a class="page-link" href="#">1</a></li>
                <li class="page-item active">
                    <a class="page-link" href="#" aria-current="page">2</a>
                </li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Next</a>
                </li>
            </ul>
        </nav>
    </div><!-- /post-container -->
</div>